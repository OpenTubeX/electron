+
+#ifndef UI_OZONE_PLATFORM_WAYLAND_HOST_XX_PIP_H_
+#define UI_OZONE_PLATFORM_WAYLAND_HOST_XX_PIP_H_
+
+#include <cstdint>
+#include <memory>
+#include <string>
+
+#include "ui/gfx/geometry/rect.h"
+#include "ui/ozone/platform/wayland/common/wayland_object.h"
+#include "ui/ozone/platform/wayland/host/xdg_surface.h"
+
+struct xx_pip_shell_v1;
+struct xx_pip_v1;
+
+namespace ui {
+
+class WaylandConnection;
+
+// Binds the experimental xx-pip-v1 compositor global when it is advertised.
+class XxPipShell : public wl::GlobalObjectRegistrar<XxPipShell> {
+ public:
+  static constexpr char kInterfaceName[] = "xx_pip_shell_v1";
+
+  static void Instantiate(WaylandConnection* connection,
+                          wl_registry* registry,
+                          uint32_t name,
+                          const std::string& interface,
+                          uint32_t version);
+
+  XxPipShell() = delete;
+};
+
+// Wrapper for the xx_pip_v1 xdg_surface role.
+class XxPip {
+ public:
+  explicit XxPip(std::unique_ptr<XdgSurface> xdg_surface);
+  XxPip(const XxPip&) = delete;
+  XxPip& operator=(const XxPip&) = delete;
+  ~XxPip();
+
+  bool Initialize(xx_pip_shell_v1* shell);
+  void SurfaceMove(WaylandConnection* connection);
+  void SurfaceResize(WaylandConnection* connection, uint32_t hittest);
+  void SetAppId(const std::string& app_id);
+  void SetWindowGeometry(const gfx::Rect& bounds);
+  void AckConfigure(uint32_t serial);
+  bool IsConfigured();
+
+ private:
+  static void OnClosed(void* data, xx_pip_v1* pip);
+  static void OnConfigureBounds(void* data,
+                                xx_pip_v1* pip,
+                                int32_t width,
+                                int32_t height);
+  static void OnConfigureSize(void* data,
+                              xx_pip_v1* pip,
+                              int32_t width,
+                              int32_t height);
+
+  WaylandConnection* connection() const { return xdg_surface_->connection_; }
+  WaylandWindow* window() const { return xdg_surface_->wayland_window_; }
+
+  const std::unique_ptr<XdgSurface> xdg_surface_;
+  wl::Object<xx_pip_v1> pip_;
+};
+
+}  // namespace ui
+
+#endif  // UI_OZONE_PLATFORM_WAYLAND_HOST_XX_PIP_H_
