+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "ui/ozone/platform/wayland/host/xx_pip.h"
+
+#include <xx-pip-v1-client-protocol.h>
+
+#include <algorithm>
+#include <optional>
+
+#include "base/check.h"
+#include "base/check_op.h"
+#include "base/logging.h"
+#include "ui/base/hit_test.h"
+#include "ui/ozone/platform/wayland/common/wayland_util.h"
+#include "ui/ozone/platform/wayland/host/wayland_connection.h"
+#include "ui/ozone/platform/wayland/host/wayland_seat.h"
+#include "ui/ozone/platform/wayland/host/wayland_serial_tracker.h"
+#include "ui/ozone/platform/wayland/host/wayland_toplevel_window.h"
+#include "ui/ozone/platform/wayland/host/wayland_window.h"
+
+namespace ui {
+
+namespace {
+
+constexpr uint32_t kMaxVersion = 1;
+
+std::optional<wl::Serial> GetSerialForMoveResize(
+    WaylandConnection* connection) {
+  return connection->serial_tracker().GetSerial({wl::SerialType::kTouchPress,
+                                                 wl::SerialType::kMousePress,
+                                                 wl::SerialType::kKeyPress});
+}
+
+}  // namespace
+
+// static
+void XxPipShell::Instantiate(WaylandConnection* connection,
+                             wl_registry* registry,
+                             uint32_t name,
+                             const std::string& interface,
+                             uint32_t version) {
+  CHECK_EQ(interface, kInterfaceName) << "Expected \"" << kInterfaceName
+                                      << "\" but got \"" << interface << "\"";
+  if (connection->xx_pip_shell_v1_) {
+    return;
+  }
+
+  auto instance = wl::Bind<::xx_pip_shell_v1>(registry, name,
+                                              std::min(version, kMaxVersion));
+  if (!instance) {
+    LOG(ERROR) << "Failed to bind " << kInterfaceName;
+    return;
+  }
+  connection->xx_pip_shell_v1_ = std::move(instance);
+}
+
+XxPip::XxPip(std::unique_ptr<XdgSurface> xdg_surface)
+    : xdg_surface_(std::move(xdg_surface)) {
+  CHECK(xdg_surface_);
+}
+
+XxPip::~XxPip() = default;
+
+bool XxPip::Initialize(xx_pip_shell_v1* shell) {
+  CHECK(shell);
+  pip_.reset(xx_pip_shell_v1_get_pip(shell, xdg_surface_->wl_object()));
+  if (!pip_) {
+    LOG(ERROR) << "Failed to create xx_pip_v1";
+    return false;
+  }
+
+  connection()->window_manager()->NotifyWindowRoleAssigned(window());
+  static constexpr xx_pip_v1_listener kListener = {
+      .closed = &OnClosed,
+      .configure_bounds = &OnConfigureBounds,
+      .configure_size = &OnConfigureSize,
+  };
+  xx_pip_v1_add_listener(pip_.get(), &kListener, this);
+  return true;
+}
+
+void XxPip::SurfaceMove(WaylandConnection* connection) {
+  if (auto serial = GetSerialForMoveResize(connection)) {
+    xx_pip_v1_move(pip_.get(), connection->seat()->wl_object(), serial->value);
+  }
+}
+
+void XxPip::SurfaceResize(WaylandConnection* connection, uint32_t hittest) {
+  if (auto serial = GetSerialForMoveResize(connection)) {
+    xx_pip_v1_resize(pip_.get(), connection->seat()->wl_object(), serial->value,
+                     wl::IdentifyDirection(hittest));
+  }
+}
+
+void XxPip::SetAppId(const std::string& app_id) {
+  xx_pip_v1_set_app_id(pip_.get(), app_id.c_str());
+}
+
+void XxPip::SetWindowGeometry(const gfx::Rect& bounds) {
+  xdg_surface_->SetWindowGeometry(bounds);
+}
+
+void XxPip::AckConfigure(uint32_t serial) {
+  xdg_surface_->AckConfigure(serial);
+}
+
+bool XxPip::IsConfigured() {
+  return xdg_surface_->IsConfigured();
+}
+
+// static
+void XxPip::OnClosed(void* data, xx_pip_v1* pip) {
+  auto* self = static_cast<XxPip*>(data);
+  CHECK(self);
+  self->window()->OnCloseRequest();
+}
+
+// static
+void XxPip::OnConfigureBounds(void* data,
+                              xx_pip_v1* pip,
+                              int32_t width,
+                              int32_t height) {
+  auto* self = static_cast<XxPip*>(data);
+  CHECK(self);
+  auto* window = self->window()->AsWaylandToplevelWindow();
+  CHECK(window);
+  window->HandlePictureInPictureConfigureBounds(width, height);
+}
+
+// static
+void XxPip::OnConfigureSize(void* data,
+                            xx_pip_v1* pip,
+                            int32_t width,
+                            int32_t height) {
+  auto* self = static_cast<XxPip*>(data);
+  CHECK(self);
+  self->window()->HandleToplevelConfigure(width, height, {});
+}
+
+}  // namespace ui
