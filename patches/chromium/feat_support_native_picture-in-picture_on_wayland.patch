+
+class MockXxPipShellV1 : public GlobalObject {
+ public:
+  MockXxPipShellV1();
+  MockXxPipShellV1(const MockXxPipShellV1&) = delete;
+  MockXxPipShellV1& operator=(const MockXxPipShellV1&) = delete;
+  ~MockXxPipShellV1() override;
+
+  void set_pip(MockXxPipV1* pip) { pip_ = pip; }
+  MockXxPipV1* pip() const { return pip_; }
+
+ private:
+  raw_ptr<MockXxPipV1> pip_ = nullptr;
+};
+
+class MockXxPipV1 : public ServerObject {
+ public:
+  MockXxPipV1(wl_resource* resource,
+              MockXxPipShellV1* global,
+              MockXdgSurface* xdg_surface);
+  MockXxPipV1(const MockXxPipV1&) = delete;
+  MockXxPipV1& operator=(const MockXxPipV1&) = delete;
+  ~MockXxPipV1() override;
+
+  MockXdgSurface* xdg_surface() const { return xdg_surface_; }
+  const std::string& app_id() const { return app_id_; }
+  void set_app_id(const char* app_id) { app_id_ = app_id; }
+
+  void SendConfigureBounds(const gfx::Size& bounds);
+  void SendConfigureSize(const gfx::Size& size);
+  void SendSurfaceConfigure(uint32_t serial);
+
+ private:
+  raw_ptr<MockXxPipShellV1> global_;
+  raw_ptr<MockXdgSurface> xdg_surface_;
+  std::string app_id_;
+};
+
+}  // namespace wl
+
+#endif  // UI_OZONE_PLATFORM_WAYLAND_TEST_MOCK_XX_PIP_H_
